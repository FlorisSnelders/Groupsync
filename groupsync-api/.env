# ─── Server ────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── PostgreSQL ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=groupsync
DB_USER=postgres
DB_PASSWORD=groupsync123

# ─── Auth ──────────────────────────────────────────
JWT_SECRET=groupsync-block-c-demo-secret-9f3a7c2e1b
JWT_EXPIRES_IN=7d

# ─── OpenAI (AI planning feature) ─────────────────
# Optional: add your key for real tailored AI plans. Without it, the app
# falls back to 3 generic options (still works on camera).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── CORS ─────────────────────────────────────────
CORS_ORIGIN=*
